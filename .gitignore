# Build trees.
build/
build-*/

# Copyrighted material. The BIOS dump and any commercial ROM are needed to run
# this and are never part of it.
roms/
bios/
*.gba
*.bin
!packaging/*.bin

# Things the app writes at runtime, in case it is ever run from the repo.
*.sav
imgui.ini
*.cfg

# Packaged output and the tools fetched to build it.
*.AppImage
runtime-x86_64

# Packaging scratch. squashfs-root is where --appimage-extract unpacks.
build/AppDir/
squashfs-root/
build-asan/

# Archipelago: an 87MB third-party AppImage, and patch files that carry
# somebody's slot name and seed. Neither belongs in the repository.
Archipelago/
archipelago/
*.apemerald
*.apbn3
*.apz3
